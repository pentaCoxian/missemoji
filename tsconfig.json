{
  // Nuxt 4 "solution" layout: the real projects are generated by `nuxt prepare`
  // into .nuxt/. `nuxt typecheck` runs `vue-tsc -b --noEmit` across all of them.
  // core/, workers/ and types/ are added to the app project via
  // `typescript.tsConfig.include` in nuxt.config.ts so they are checked with the
  // same lib set (dom + webworker) the app uses.
  "files": [],
  "references": [
    { "path": "./.nuxt/tsconfig.app.json" },
    { "path": "./.nuxt/tsconfig.server.json" },
    { "path": "./.nuxt/tsconfig.shared.json" },
    { "path": "./.nuxt/tsconfig.node.json" }
  ]
}
